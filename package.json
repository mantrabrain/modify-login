{
  "name": "modify-login",
  "version": "3.1.0",
  "private": true,
  "description": "Authlify (formerly Modify Login). Build tooling for the login page designer.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build:designer": "wp-scripts build --config node_modules/@wordpress/scripts/config/webpack.config.js --webpack-src-dir=assets/designer/src --output-path=assets/designer/build",
