msgid "CAPTCHA"
msgstr ""

#: inc/Admin/Docs.php:853
#: inc/Admin/Docs.php:1115
#: inc/Admin/Docs.php:1139
msgid "Two-factor recovery"
msgstr ""

#: inc/Admin/Docs.php:858
msgid "An automatic test that visits your site as a stranger would and proves the hidden login address is not revealed anywhere."
msgstr ""

#: inc/Admin/Docs.php:860
msgid "Many “hide login” plugins can be found in one request: a password-reset link, a redirect from /wp-admin/ or a theme link gives the secret address away. Leak Check tries those routes against your own site and reports what it finds."
msgstr ""

#: inc/Admin/Docs.php:861
#, php-format
msgid "The Leak Check panel on the %1$s, a status line on the %2$s screen, a dashboard checklist item, WordPress Site Health, and the <code>wp authlify leak-check</code> command."
msgstr ""

