#: inc/Admin/Docs.php:762
msgid "After a week"
msgstr ""

#: inc/Admin/Docs.php:763
msgid "Turn off CAPTCHA test mode if nobody real would have been blocked."
msgstr ""

#: inc/Admin/Docs.php:764
