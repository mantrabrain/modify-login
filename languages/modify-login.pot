msgstr ""

#: inc/Admin/Docs.php:1230
msgid "Move your setup between sites, copy settings from other login plugins, and decide what happens to your data on uninstall."
msgstr ""

#: inc/Admin/Docs.php:1232
#: inc/Admin/Docs.php:1571
msgid "Authlify → Settings"
msgstr ""

