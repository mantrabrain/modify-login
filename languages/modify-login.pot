#: inc/Admin/Docs.php:1159
msgid "<strong>Match my site</strong> builds a design from your theme’s colours, font and logo (from theme.json and the Site Editor, the Customizer, and popular themes such as Astra, GeneratePress, Kadence and Blocksy). It reads your own site only, and nothing is saved until you click Save."
msgstr ""

#: inc/Admin/Docs.php:1161
#: inc/Admin/UI.php:588
#: inc/Admin/UI.php:689
msgid "Sections"
msgstr ""

