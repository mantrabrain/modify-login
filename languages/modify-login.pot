#: inc/Admin/ToolsPage.php:162
#: inc/Admin/ToolsPage.php:193
msgid "Import"
msgstr ""

#: inc/Admin/Docs.php:1241
msgid "Choose a file exported by Authlify and click <strong>Import settings</strong>. Other files are refused."
msgstr ""

